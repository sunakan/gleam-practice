#!/usr/bin/env bash
# MISE description="dist/vercmp（escript）の E2E テスト。先に build を実行する"
# MISE depends=["build"]
set -euo pipefail

bin=dist/vercmp
failed=0

# args を配列にしないのは、引数なしのケースで macOS 標準の bash 3.2 が set -u で落ちるため
check() {
  local name=$1 want_code=$2 want_out=$3 want_err=$4 args=$5
  local out err_file err code=0
  err_file=$(mktemp)
  # shellcheck disable=SC2086
  out=$("$bin" $args 2>"$err_file") || code=$?
  err=$(cat "$err_file")
  rm -f "$err_file"

  if [[ "$code" == "$want_code" && "$out" == "$want_out" && "$err" == "$want_err" ]]; then
    echo "ok   $name"
  else
    echo "FAIL $name"
    echo "  exit:   want=$want_code got=$code"
    echo "  stdout: want=$want_out got=$out"
    echo "  stderr: want=$want_err got=$err"
    failed=1
  fi
}

# check "名前" 期待する終了コード 期待する標準出力 期待する標準エラー "引数"
check "小さい" 0 "<" "" "1.2 1.10"
check "大きい" 0 ">" "" "1.10 1.2"
check "末尾の0は等しい" 0 "=" "" "1.2 1.2.0"
check "最初の差で決まる" 0 ">" "" "2 1.9.9.9"
check "不正なバージョン" 1 "" "不正なバージョン: 1.x" "1.x 1.0"
check "負の値" 1 "" "不正なバージョン: 1.-1" "1.-1 1.0"
check "引数が足りない" 1 "" "使い方: vercmp <a> <b>" "1.2"
check "引数なし" 1 "" "使い方: vercmp <a> <b>" ""

exit "$failed"
