#!/usr/bin/env bash
# MISE description="dist/stats（escript）の E2E テスト。先に build を実行する"
# MISE depends=["build"]
set -euo pipefail

bin=dist/stats
failed=0

# args を配列にしないのは、引数なしのケースで macOS 標準の bash 3.2 が set -u で落ちるため
check() {
  local name=$1 want_code=$2 want_out=$3 want_err=$4 args=$5
  local out err_file err code=0
  err_file=$(mktemp)
  # shellcheck disable=SC2086
  out=$("$bin" $args 2>"$err_file") || code=$?
  err=$(cat "$err_file")
  rm -f "$err_file"

  if [[ "$code" == "$want_code" && "$out" == "$want_out" && "$err" == "$want_err" ]]; then
    echo "ok   $name"
  else
    echo "FAIL $name"
    echo "  exit:   want=$want_code got=$code"
    echo "  stdout: want=$want_out got=$out"
    echo "  stderr: want=$want_err got=$err"
    failed=1
  fi
}

# check "名前" 期待する終了コード 期待する標準出力 期待する標準エラー "引数"
check "集計" 0 "count: 5
sum: 14
min: 1
max: 5
mean: 2.8
median: 3.0" "" "3 1 4 1 5"

check "偶数個の中央値" 0 "count: 4
sum: 10
min: 1
max: 4
mean: 2.5
median: 2.5" "" "1 2 3 4"

check "不正な値" 1 "" "数値ではありません: x" "1 x 3"

check "引数なしは使い方" 1 "" "使い方: stats <整数>..." ""

exit "$failed"
