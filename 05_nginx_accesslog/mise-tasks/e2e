#!/usr/bin/env bash
# MISE description="dist/nginx_accesslog（escript）の E2E テスト。先に build を実行する"
# MISE depends=["build"]
set -euo pipefail

bin=dist/nginx_accesslog
failed=0

# args を配列にしないのは、引数なしのケースで macOS 標準の bash 3.2 が set -u で落ちるため
check() {
  local name=$1 want_code=$2 want_out=$3 want_err=$4 args=$5
  local out err_file err code=0
  err_file=$(mktemp)
  # shellcheck disable=SC2086
  out=$("$bin" $args 2>"$err_file") || code=$?
  err=$(cat "$err_file")
  rm -f "$err_file"

  if [[ "$code" == "$want_code" && "$out" == "$want_out" && "$err" == "$want_err" ]]; then
    echo "ok   $name"
  else
    echo "FAIL $name"
    echo "  exit:   want=$want_code got=$code"
    echo "  stdout: want=$want_out got=$out"
    echo "  stderr: want=$want_err got=$err"
    failed=1
  fi
}

# check "名前" 期待する終了コード 期待する標準出力 期待する標準エラー "引数"
check "抜粋ログの集計" 0 "17 POST 200
6 GET 200
5 POST 400
3 GET 403
3 GET 499
3 POST 404
2 GET 404
2 POST 401
2 POST 499
1 GET 401
skipped: 0" "" "testdata/access.log"

check "壊れた行と空行" 0 "2 GET 200
1 POST 500
skipped: 3" "" "testdata/broken.log"

check "存在しないファイル" 1 "" "No such file or directory" "testdata/nothing.log"
check "引数なしは使い方" 1 "" "使い方: nginx_accesslog <ログファイルのパス>" ""
check "引数が多すぎる" 1 "" "使い方: nginx_accesslog <ログファイルのパス>" "a b"

exit "$failed"
