#!/usr/bin/env bash
# MISE description="dist/mysql_slowquerylog_duration（escript）の E2E テスト。先に build を実行する"
# MISE depends=["build"]
set -euo pipefail

bin=dist/mysql_slowquerylog_duration
failed=0

# args を配列にしないのは、引数なしのケースで macOS 標準の bash 3.2 が set -u で落ちるため
check() {
  local name=$1 want_code=$2 want_out=$3 want_err=$4 args=$5
  local out err_file err code=0
  err_file=$(mktemp)
  # shellcheck disable=SC2086
  out=$("$bin" $args 2>"$err_file") || code=$?
  err=$(cat "$err_file")
  rm -f "$err_file"

  if [[ "$code" == "$want_code" && "$out" == "$want_out" && "$err" == "$want_err" ]]; then
    echo "ok   $name"
  else
    echo "FAIL $name"
    echo "  exit:   want=$want_code got=$code"
    echo "  stdout: want=$want_out got=$out"
    echo "  stderr: want=$want_err got=$err"
    failed=1
  fi
}

# check "名前" 期待する終了コード 期待する標準出力 期待する標準エラー "引数"
check "抜粋ログの期間" 0 "entries: 30
start: 2026-10-03T07:40:43.106011Z
end: 2026-10-03T07:40:56.718644Z
duration: 13s
skipped: 0" "" "testdata/slow.log"

check "読めない時刻とSQL中の文字列" 0 "entries: 2
start: 2026-10-03T07:00:00Z
end: 2026-10-03T07:01:05Z
duration: 1m5s
skipped: 1" "" "testdata/broken.log"

check "有効なエントリがない" 1 "" "有効なエントリがありません" "testdata/no_entries.log"
check "存在しないファイル" 1 "" "No such file or directory" "testdata/nothing.log"
check "引数なしは使い方" 1 "" "使い方: mysql_slowquerylog_duration <スロークエリログのパス>" ""
check "引数が多すぎる" 1 "" "使い方: mysql_slowquerylog_duration <スロークエリログのパス>" "a b"

exit "$failed"
