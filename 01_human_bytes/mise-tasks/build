#!/usr/bin/env bash
# MISE description="escript を build/human_bytes に生成"
set -euo pipefail

# escript: 出力先が固定（プロジェクト直下）のため、build/ へ移す
gleam export escript
mv -f human_bytes build/human_bytes

# erlang-shipment: 出力先は build/erlang-shipment 固定のため、名前を変えてコピーする
gleam export erlang-shipment
rm -rf build/human_bytes_shipment
cp -R build/erlang-shipment build/human_bytes_shipment

# JS: 依存が兄弟ディレクトリで相対参照されるため、build/dev/javascript を丸ごとコピーする
gleam build --target javascript
rm -rf build/human_bytes_js
cp -R build/dev/javascript build/human_bytes_js
