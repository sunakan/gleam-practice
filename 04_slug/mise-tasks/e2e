#!/usr/bin/env bash
# MISE description="dist/slug（escript）の E2E テスト。先に build を実行する"
# MISE depends=["build"]
set -euo pipefail

bin=dist/slug
failed=0

# args を配列にしないのは、引数なしのケースで macOS 標準の bash 3.2 が set -u で落ちるため
check() {
  local name=$1 want_code=$2 want_out=$3 want_err=$4 args=$5
  local out err_file err code=0
  err_file=$(mktemp)
  # shellcheck disable=SC2086
  out=$("$bin" $args 2>"$err_file") || code=$?
  err=$(cat "$err_file")
  rm -f "$err_file"

  if [[ "$code" == "$want_code" && "$out" == "$want_out" && "$err" == "$want_err" ]]; then
    echo "ok   $name"
  else
    echo "FAIL $name"
    echo "  exit:   want=$want_code got=$code"
    echo "  stdout: want=$want_out got=$out"
    echo "  stderr: want=$want_err got=$err"
    failed=1
  fi
}

# check "名前" 期待する終了コード 期待する標準出力 期待する標準エラー "引数"
check "記号を除く" 0 "hello-world" "" "Hello, World!"
check "連続する空白" 0 "gleam-is-fun" "" "Gleam is   fun"
check "数字を残す" 0 "hello-world-2026" "" "Hello, World! 2026"
check "区切りの連続と端" 0 "a-b" "" "--a--b--"
check "日本語は区切り" 0 "a-b" "" "a日本語b"
check "日本語のみは空" 0 "" "" "日本語"
check "引数なしは使い方" 1 "" "使い方: slug <文章>..." ""

exit "$failed"
