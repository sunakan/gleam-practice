#!/usr/bin/env bash
# MISE description="dist/ipv4_parse_with_pbt（escript）の E2E テスト。先に build を実行する"
# MISE depends=["build"]
set -euo pipefail

bin=dist/ipv4_parse_with_pbt
failed=0

# args を配列にしないのは、引数なしのケースで macOS 標準の bash 3.2 が set -u で落ちるため
check() {
  local name=$1 want_code=$2 want_out=$3 want_err=$4 args=$5
  local out err_file err code=0
  err_file=$(mktemp)
  # shellcheck disable=SC2086
  out=$("$bin" $args 2>"$err_file") || code=$?
  err=$(cat "$err_file")
  rm -f "$err_file"

  if [[ "$code" == "$want_code" && "$out" == "$want_out" && "$err" == "$want_err" ]]; then
    echo "ok   $name"
  else
    echo "FAIL $name"
    echo "  exit:   want=$want_code got=$code"
    echo "  stdout: want=$want_out got=$out"
    echo "  stderr: want=$want_err got=$err"
    failed=1
  fi
}

# check "名前" 期待する終了コード 期待する標準出力 期待する標準エラー "引数"
check "有効なアドレス1つ" 0 "192.168.0.1 ok" "" "192.168.0.1"
check "0 は有効" 0 "0.0.0.0 ok" "" "0.0.0.0"
check "有効なアドレス2つ" 0 "10.0.0.1 ok
255.255.255.255 ok" "" "10.0.0.1 255.255.255.255"

check "不正が混ざる場合は全部出力して終了コード2" 2 "1.2.3.4 ok
1.2.3.256 error: 範囲外です: 256" "" "1.2.3.4 1.2.3.256"
check "要素の数が違う" 2 "1.2.3 error: 要素の数が4ではありません(3)" "" "1.2.3"
check "空の要素" 2 "1..3.4 error: 空の要素があります" "" "1..3.4"
check "数字ではない" 2 "a.2.3.4 error: 数字ではありません: a" "" "a.2.3.4"
check "プラス記号は数字ではない" 2 "+1.2.3.4 error: 数字ではありません: +1" "" "+1.2.3.4"
check "先頭の0" 2 "01.2.3.4 error: 先頭に0があります: 01" "" "01.2.3.4"
check "判定順は左の要素が先" 2 "1.256.01.4 error: 範囲外です: 256" "" "1.256.01.4"

check "引数なしは使い方" 1 "" "使い方: ipv4_parse_with_pbt <Ipv4アドレス>..." ""

exit "$failed"
